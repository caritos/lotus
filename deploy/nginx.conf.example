# NGINX reverse proxy for the app. Replace app.example.com and the upstream port
# (the ADDR port in the app's .env). See docs/https.md for the certbot steps.

upstream app {
    server 127.0.0.1:8080;
    keepalive 16;
}

# Plain HTTP: serve the ACME challenge, redirect everything else to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

    # HSTS is set here, by the proxy; the app never sends it. Browsers remember it, so
    # start short (300 s) and raise it (for example to 31536000) only after every page
    # works over HTTPS. See docs/https.md.
    add_header Strict-Transport-Security "max-age=300" always;

    # Photo uploads: the app caps request bodies at 8 MiB; keep this at or above that.
    client_max_body_size 8m;

    location / {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
