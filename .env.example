# Runtime configuration. Copy to .env and edit; the server reads real environment variables only.

# development or production. Production refuses to start without SESSION_SECRET and PUBLIC_ORIGIN. Default: development
APP_ENV=development
# Listen address. Default: :8080
# Own NGINX (or any proxy) on the same host: 127.0.0.1:<port>, so plain HTTP is never exposed.
# Hosting panel proxy that reaches the app through the machine's public address: 0.0.0.0:<port>
# (loopback-only gives 502 there) and set TRUSTED_PROXY to that proxy's address.
# deploy.sh reads the port after the last colon for its health check.
# Values in a server .env are read by systemd and by deploy.sh: no quotes, no spaces.
ADDR=:8080
# Directory holding db/, logs/, storage/ and backups/. Default: .
# On a server a value here OVERRIDES the systemd unit's Environment=DATA_DIR (relative values are
# relative to the unit's WorkingDirectory, ~/goweb/data). Best left unset on a server.
DATA_DIR=.
# Public https origin of the site, e.g. https://example.com (required in production). Default: empty
PUBLIC_ORIGIN=
# Long random string used to sign sessions (required in production). Default: empty
SESSION_SECRET=
# Mark cookies Secure. Default: true in production, false otherwise
SECURE_COOKIES=false
# CIDR of the reverse proxy whose X-Forwarded-For is trusted. Default: empty (trust none).
# Same-host NGINX: 127.0.0.1/32. Panel proxy: that proxy's address (see docs/https.md).
# Empty behind a proxy means per-IP limits key on the proxy's address.
TRUSTED_PROXY=
# How long a sign-in lasts, as a Go duration. Default: 720h
SESSION_TTL=720h
