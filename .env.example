# Runtime configuration. Copy to .env and edit; the server reads real environment variables only.

# development or production. Production refuses to start without SESSION_SECRET and PUBLIC_ORIGIN. Default: development
APP_ENV=development
# Listen address. Default: :8080
ADDR=:8080
# Directory holding db/, logs/, storage/ and backups/. Default: .
DATA_DIR=.
# Public https origin of the site, e.g. https://example.com (required in production). Default: empty
PUBLIC_ORIGIN=
# Long random string used to sign sessions (required in production). Default: empty
SESSION_SECRET=
# Mark cookies Secure. Default: true in production, false otherwise
SECURE_COOKIES=false
# CIDR of the reverse proxy whose X-Forwarded-For is trusted. Default: empty (trust none)
TRUSTED_PROXY=
# How long a sign-in lasts, as a Go duration. Default: 720h
SESSION_TTL=720h
