# Server runtime configuration: the template for the server's .env (~/app/.env, see docs/deploy.md).
# Local development does not use this file: `make dev` sets its own environment.
# The server reads real environment variables only (systemd loads this file through EnvironmentFile=).
# Write KEY=value with no quotes and no spaces: systemd and deploy.sh read it line by line.

# development or production. A server must say production: deploy.sh refuses to deploy otherwise
# (unless ALLOW_DEV_DEPLOY=1), and production refuses to start without SESSION_SECRET and PUBLIC_ORIGIN.
APP_ENV=production

# REQUIRED. Long random string used to sign sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED. Public origin of the site, scheme and host only, e.g. https://app.example.com
# (no path; a trailing slash, upper case and a default :443 are normalized away).
# The same-origin check on sign-in and every other POST, PUT, PATCH and DELETE compares against it.
PUBLIC_ORIGIN=

# Listen address. Default: :8080 (every interface).
# Own NGINX (or any proxy) on the same host: 127.0.0.1:<port>, so plain HTTP is never exposed.
# Hosting panel proxy that reaches the app through the machine's public address: 0.0.0.0:<port>
# (loopback-only gives 502 there) and set TRUSTED_PROXY to that proxy's address.
# deploy.sh reads the port after the last colon for its health check (on 127.0.0.1).
# Set EXPECT_PUBLIC_LISTENER=1 in the environment of deploy.sh (not in this file) behind a panel proxy:
# it refuses a loopback ADDR here and checks that a public listener exists after the restart.
ADDR=127.0.0.1:8080

# CIDR(s) of the reverse proxy whose X-Forwarded-For is trusted. Default: empty (trust none).
# Same-host NGINX: 127.0.0.1/32. Panel proxy: that proxy's address (see docs/https.md).
# Empty behind a proxy means per-IP sign-in limits key on the proxy's address, shared by everyone.
TRUSTED_PROXY=127.0.0.1/32

# Mark the session cookie Secure. Default: follows APP_ENV (true in production, false in development).
# HTTPS and HSTS come from the reverse proxy; the app never sends Strict-Transport-Security.
# SECURE_COOKIES=true

# Directory holding db/, logs/, storage/ and backups/. Default: . (the working directory).
# The systemd units already set DATA_DIR=~/app/data; a value here OVERRIDES that (relative values
# are relative to the unit's WorkingDirectory, ~/app/data). Best left unset on a server.
# DATA_DIR=

# How long a sign-in lasts, as a Go duration. Default: 720h
# SESSION_TTL=720h
