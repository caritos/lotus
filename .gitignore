.superpowers/
.env
.DS_Store

# build outputs
node_modules/
web/test/e2e/test-results/
web/test/e2e/playwright-report/
web/dist/
/bin/
web/api/app
# go:embed source, generated: pages/ and static/ by web/scripts/sync-public.sh, spa/ by pnpm build
web/api/embed/*
!web/api/embed/.gitkeep
!web/api/embed/embed.go

# runtime data
web/db/*
!web/db/.gitkeep
web/logs/*
!web/logs/.gitkeep
web/storage/*
!web/storage/.gitkeep
web/api/internal/db/*.db*
