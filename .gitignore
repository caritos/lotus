.superpowers/
.env
.DS_Store

# build outputs
node_modules/
web/test/e2e/test-results/
web/test/e2e/playwright-report/
web/dist/
/bin/
web/api/app
web/api/internal/web/app/*
!web/api/internal/web/app/.gitkeep
# generated copy of web/public (go:embed source); see web/scripts/sync-public.sh
web/api/internal/web/public/*
!web/api/internal/web/public/.gitkeep

# runtime data
web/db/*
!web/db/.gitkeep
web/logs/*
!web/logs/.gitkeep
web/storage/*
!web/storage/.gitkeep
web/api/internal/db/*.db*
